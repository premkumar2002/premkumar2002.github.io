# Set your canonical production origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional Formspree endpoint. Empty = opens an email draft in the visitor's mail app.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
# Static export for GitHub Pages or static hosting: true or false.
STATIC_EXPORT=false
# GitHub project Pages only: /repository-name. Leave empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=
